from rest_framework import serializers
from .models import (
    Project, Tower, Floor, Unit,
    ChecklistTemplate, ChecklistTemplateItem,
    ChecklistSubmission, ChecklistItemResult, ChecklistItemPhoto,
    Issue,
)


class ChecklistTemplateItemSerializer(serializers.ModelSerializer):
    class Meta:
        model = ChecklistTemplateItem
        fields = ["id", "sequence", "stage", "question", "requires_photo", "requires_note"]


class ChecklistTemplateSerializer(serializers.ModelSerializer):
    items = ChecklistTemplateItemSerializer(many=True, read_only=True)

    class Meta:
        model = ChecklistTemplate
        fields = ["id", "name", "activity_type", "version", "is_active", "items"]


class ChecklistItemPhotoSerializer(serializers.ModelSerializer):
    s3_url = serializers.ReadOnlyField()

    class Meta:
        model = ChecklistItemPhoto
        fields = [
            "id", "client_uuid", "s3_key", "s3_url", "caption",
            "device_id", "taken_at", "uploaded_at",
        ]


class ChecklistItemResultSerializer(serializers.ModelSerializer):
    photos = ChecklistItemPhotoSerializer(many=True, read_only=True)

    class Meta:
        model = ChecklistItemResult
        fields = [
            "id", "template_item", "status", "note",
            "verified_by", "verified_at", "photos",
        ]
        read_only_fields = ["verified_by", "verified_at"]


class ChecklistSubmissionSerializer(serializers.ModelSerializer):
    """
    Used for L1's offline-sync payload: submission header + all item results
    in one shot, so a half-synced checklist can never exist server-side.
    """
    item_results = ChecklistItemResultSerializer(many=True, required=False)

    class Meta:
        model = ChecklistSubmission
        fields = [
            "id", "client_uuid", "template", "project", "tower", "floor", "unit",
            "filled_by", "verified_by", "audited_by", "status",
            "filled_at_device_time", "synced_at", "verified_at",
            "item_results",
        ]
        read_only_fields = ["filled_by", "verified_by", "audited_by", "synced_at"]

    def create(self, validated_data):
        item_results_data = validated_data.pop("item_results", [])
        request = self.context["request"]
        validated_data["filled_by"] = request.user
        submission = ChecklistSubmission.objects.create(**validated_data)
        for item_data in item_results_data:
            ChecklistItemResult.objects.create(submission=submission, **item_data)
        return submission


class IssueSerializer(serializers.ModelSerializer):
    class Meta:
        model = Issue
        fields = [
            "id", "checklist_item_result", "raised_by", "assigned_to",
            "source", "description", "status", "due_date",
            "created_at", "resolved_at", "closed_at",
        ]
        read_only_fields = ["raised_by", "created_at", "resolved_at", "closed_at"]

    def create(self, validated_data):
        validated_data["raised_by"] = self.context["request"].user
        return Issue.objects.create(**validated_data)


class ProjectSerializer(serializers.ModelSerializer):
    class Meta:
